    "version": "0.2.0",
    "configurations": [
        {
            "name": "apevolo_flutter",
            "request": "launch",
            "type": "dart",
            "args": ["--web-port=8001"]
        },
        {
            "name": "apevolo_flutter(Web)",
            "request": "launch",
            "type": "dart",
            "deviceId": "web-server",
            "args": [
                "--web-port=8001",
                "-d",
                "chrome",
                "--web-experimental-hot-reload"
            ]
        },
        {
            "name": "apevolo_flutter (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "apevolo_flutter (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            "name": "apevolo_flutter (main2)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main2.dart",
            "args": ["--web-port=8001"]
        }
    ]
}
